# --- Frontend (Vite) ---------------------------------------------------------
# Browser-visible key: Maps JavaScript API + Street View embeds ONLY.
# Restrict in Google Cloud Console to those APIs + application restrictions.
# This is the ONLY Google key that may be exposed to the frontend.
VITE_GOOGLE_MAPS_JS_KEY=

# Default amenity search radius in meters (used by the UI).
VITE_DEFAULT_SEARCH_RADIUS_METERS=8000

# --- Backend (Rust) ----------------------------------------------------------
# Private, billed web-service key: Geocoding, Routes, Places.
# In this app the web-service key is normally entered at runtime on the
# Settings page and stored in the local SQLite database, so it does NOT need to
# live here. It is listed for reference only. If you do set it via the
# environment, the Rust backend reads it — it must NOT be prefixed with VITE_
# and must never be exposed to the frontend.
# GOOGLE_WEBSERVICE_KEY=
