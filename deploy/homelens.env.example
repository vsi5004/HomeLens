# HomeLens server configuration (copy to /etc/homelens/homelens.env on Debian).
#
# Path to the SQLite database. The parent directory is created if missing.
HOMELENS_DB=/var/lib/homelens/homelens.db

# Address:port to bind. 0.0.0.0 exposes it to your whole LAN; use 127.0.0.1
# if you only want local access (e.g. behind a reverse proxy).
HOMELENS_BIND=0.0.0.0:8080

# Directory containing the built frontend (the contents of `dist/`).
HOMELENS_STATIC=/opt/homelens/dist

# Max parcel-upload size in MB (multipart GeoJSON import). A full NJ county
# joined to MOD-IV can exceed the 512 MB default; raise it if an import is
# rejected as too large. The upload is buffered in RAM and the JSON parse
# multiplies that, so keep it within the host's memory.
HOMELENS_MAX_UPLOAD_MB=512

# Optional: tune logging (e.g. debug, info, warn).
RUST_LOG=homelens_server=info,tower_http=warn
